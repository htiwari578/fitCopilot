// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum FitnessGoal {
  FAT_LOSS
  MUSCLE_GAIN
  MAINTENANCE
  STRENGTH
  ENDURANCE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DietType {
  VEG
  NON_VEG
  VEGAN
}

enum WorkoutStatus {
  GENERATED
  COMPLETED
  SKIPPED
}

model User {
  id              String  @id @default(cuid())
  email           String  @unique
  password        String
  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyCheckIns DailyCheckIn[]

  @@map("users")
}

model Profile {
  id String @id @default(cuid())

  firstName String
  lastName  String?

  gender      Gender
  dateOfBirth DateTime?

  heightCm Float
  weightKg Float

  goal            FitnessGoal
  activityLevel   ActivityLevel
  experienceLevel ExperienceLevel

  workoutDays     Int
  workoutDuration Int

  dietType DietType

  budget Int?

  injuries String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model WorkoutPlan {
  id String @id @default(cuid())

  title String
  goal  FitnessGoal

  estimatedDuration Int

  aiSummary String?

  status WorkoutStatus @default(GENERATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises WorkoutExercise[]

  @@map("workout_plans")
}

model WorkoutExercise {
  id            String @id @default(cuid())
  workoutPlanId String

  exerciseName String
  sets         Int
  repsMin      Int
  repsMax      Int
  restSeconds  Int
  order        Int
  notes        String?

  createdAt DateTime @default(now())

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  @@index([workoutPlanId])
  @@map("workout_exercises")
}

model DailyCheckIn {
  id String @id @default(cuid())

  userId String

  sleepHours    Float
  energyLevel   Int
  stressLevel   Int
  sorenessLevel Int

  availableMinutes Int

  waterIntakeMl Int?

  notes String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("daily_check_ins")
}
